{
	admin off
	auto_https off
}

:8080 {
	route {
		@oversized expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > {$LINK2VAULT_MAX_UPLOAD_MB:1024} * 1000 * 1000`
		respond @oversized "Request body too large" 413

		request_body {
			max_size {$LINK2VAULT_MAX_UPLOAD_MB:1024}MB
		}

		header {
			-Server
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}

		handle /healthz {
			reverse_proxy api:8000
		}

		handle /admin/* {
			basic_auth {
				{$LINK2VAULT_ADMIN_USER:example-admin} {$LINK2VAULT_ADMIN_PASSWORD_HASH:$2a$14$EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE}
			}
			reverse_proxy api:8000
		}

		# Bearer validation belongs to the Phase 2 application endpoint.
		handle /ingest/* {
			reverse_proxy api:8000
		}

		handle {
			respond "Not Found" 404
		}
	}
}
