# Sensitive repository and environment state
.git
.git/**
.env
.env*
.venv
.venv/**
**/__pycache__/**
**/.pytest_cache/**
**/.ruff_cache/**
.superpowers
.superpowers/**

# Runtime and user content
**/data/**
**/vault/**
**/media-tmp/**
**/recordings/**
**/transcripts/**
**/logs/**

# Archives, applications, recordings, and signing material
**/*.7z
**/*.aac
**/*.aab
**/*.apk
**/*.avi
**/*.flac
**/*.gz
**/*.jks
**/*.key
**/*.keystore
**/*.m4a
**/*.mkv
**/*.mov
**/*.mp3
**/*.mp4
**/*.ogg
**/*.opus
**/*.p12
**/*.pem
**/*.pfx
**/*.srt
**/*.tar
**/*.vtt
**/*.wav
**/*.webm
**/*.wma
**/*.zip

# Non-runtime repository material and unrelated source
docs
docs/**
tests
tests/**
scripts
scripts/**
deploy
deploy/**
.github
.github/**

# Deny by default, then admit only the locked API build inputs and parents.
**
!pyproject.toml
!uv.lock
!apps
!apps/api
!apps/api/link2vault
!apps/api/link2vault/**
