# Sensitive repository and environment state
.git
.git/**
.env
.env*
.venv
.venv/**
**/__pycache__/**
**/.pytest_cache/**
**/.ruff_cache/**
.superpowers
.superpowers/**

# Runtime and user content
**/data/**
**/vault/**
**/media-tmp/**
**/recordings/**
**/transcripts/**
**/logs/**

# Archives, applications, recordings, and signing material
**/*.7z
**/*.aac
**/*.aab
**/*.apk
**/*.avi
**/*.flac
**/*.gz
**/*.jks
**/*.key
**/*.keystore
**/*.m4a
**/*.mkv
**/*.mov
**/*.mp3
**/*.mp4
**/*.ogg
**/*.opus
**/*.p12
**/*.pem
**/*.pfx
**/*.srt
**/*.tar
**/*.vtt
**/*.wav
**/*.webm
**/*.wma
**/*.zip

# Non-runtime repository material and unrelated source
docs
docs/**
tests
tests/**
scripts
scripts/**
deploy
deploy/**
.github
.github/**

# Deny by default, then admit only the locked API build inputs and parents.
**
!pyproject.toml
!uv.lock
!apps
!apps/api
!apps/api/link2vault
!apps/api/link2vault/**/
!apps/api/link2vault/*.py
!apps/api/link2vault/**/*.py

# Defense in depth after includes: no sensitive or generated package content.
apps/api/link2vault/**/.env*
apps/api/link2vault/**/__pycache__/**
apps/api/link2vault/**/.pytest_cache/**
apps/api/link2vault/**/.ruff_cache/**
apps/api/link2vault/**/*.pyc
apps/api/link2vault/**/*.pyo
apps/api/link2vault/**/*.db
apps/api/link2vault/**/*.sqlite
apps/api/link2vault/**/*.sqlite3
apps/api/link2vault/**/*.pem
apps/api/link2vault/**/*.key
apps/api/link2vault/**/*.p12
apps/api/link2vault/**/*.pfx
apps/api/link2vault/**/*.jks
apps/api/link2vault/**/*.keystore
apps/api/link2vault/**/*.m4a
apps/api/link2vault/**/*.mp3
apps/api/link2vault/**/*.wav
apps/api/link2vault/**/*.aac
apps/api/link2vault/**/*.flac
apps/api/link2vault/**/*.ogg
apps/api/link2vault/**/*.opus
apps/api/link2vault/**/*.mp4
apps/api/link2vault/**/*.mov
apps/api/link2vault/**/*.mkv
apps/api/link2vault/**/*.avi
apps/api/link2vault/**/*.webm
